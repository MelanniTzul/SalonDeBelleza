# Plantilla de configuración. Copiar a .env y rellenar:  cp .env.example .env
# El archivo .env NO se sube a git.

# --- Base de datos ---
# El contenedor de MySQL solo crea el usuario root, por eso DB_USER=root.
DB_NAME=salondebellezafamiliar
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
# Puerto en tu máquina. 3307 evita chocar con un MySQL ya instalado.
# Dentro de docker-compose el backend siempre habla por el 3306 interno.
DB_PORT=3307

# --- Seguridad ---
# Clave para firmar los JWT. MÍNIMO 32 caracteres o la API no arranca.
# Generar con:  openssl rand -base64 48
JWT_SECRET=

# --- Frontend permitido (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Correo (opcional) ---
# Sin estos valores no se envían correos y /actuator/health responde DOWN.
MAIL_USERNAME=
MAIL_PASSWORD=
