<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P09" targetNamespace="http://bpmn.io/schema/bpmn" exporter="salon-de-belleza-familiar-docgen" exporterVersion="1.0">
  <bpmn:process id="P09" name="Confirmar la cita y generar el ticket" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P09">
      <bpmn:lane id="Lane_1" name="Cliente">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Sistema">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Tiene todo listo
para confirmar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_2" name="Revisa el resumen
(servicios, estilista, fecha,
hora, modalidad y total)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Confirma
la cita">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4" name="Genera un código
de ticket único">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="Guarda la cita
como CONFIRMADA">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Cita
confirmada">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="End_6" />
    <bpmn:textAnnotation id="Annotation_7">
      <bpmn:text>El código de ticket es único
(columna codigo_ticket).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Annotation_7_assoc" sourceRef="Task_4" targetRef="Annotation_7" associationDirection="None" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P09">
    <bpmndi:BPMNPlane id="BPMNPlane_P09" bpmnElement="P09">
      <bpmndi:BPMNShape id="P09_pool_di" bpmnElement="P09" isHorizontal="true">
        <dc:Bounds x="20" y="40" width="1480" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="20" y="60" width="1480" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="20" y="320" width="1480" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="142" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="112" y="211" width="96" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="295" y="150" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="495" y="150" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="695" y="410" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="895" y="410" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_6_di" bpmnElement="End_6">
        <dc:Bounds x="1142" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1112" y="211" width="96" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="178" y="190" />
        <di:waypoint x="295" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="425" y="190" />
        <di:waypoint x="495" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="625" y="190" />
        <di:waypoint x="660" y="190" />
        <di:waypoint x="660" y="450" />
        <di:waypoint x="695" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="825" y="450" />
        <di:waypoint x="895" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1025" y="450" />
        <di:waypoint x="1084" y="450" />
        <di:waypoint x="1084" y="190" />
        <di:waypoint x="1142" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Annotation_7_di" bpmnElement="Annotation_7">
        <dc:Bounds x="760" y="340" width="210" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Annotation_7_assoc_di" bpmnElement="Annotation_7_assoc">
        <di:waypoint x="760" y="410" />
        <di:waypoint x="865" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>