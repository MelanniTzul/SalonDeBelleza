<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P15" targetNamespace="http://bpmn.io/schema/bpmn" exporter="salon-de-belleza-familiar-docgen" exporterVersion="1.0">
  <bpmn:process id="P15" name="Cerrar una cita" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P15">
      <bpmn:lane id="Lane_1" name="Estilista">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Sistema">
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Llega la hora
de la cita">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_2" name="Atiende
la cita">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Marca el resultado:
completada o no asistió">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_4" name="¿El cliente
asistió?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_5" name="Marca la cita
como COMPLETADA">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_6" name="Marca la cita
como NO_ASISTIO">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_7" name="Registra el cambio
en la bitácora">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="Cita
cerrada">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Gateway_4" />
    <bpmn:sequenceFlow id="Flow_4" name="Sí" sourceRef="Gateway_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="Gateway_4" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_7" targetRef="End_8" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P15">
    <bpmndi:BPMNPlane id="BPMNPlane_P15" bpmnElement="P15">
      <bpmndi:BPMNShape id="P15_pool_di" bpmnElement="P15" isHorizontal="true">
        <dc:Bounds x="20" y="40" width="1680" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="20" y="60" width="1680" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="20" y="320" width="1680" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="142" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="112" y="211" width="96" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="295" y="150" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="495" y="150" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_4_di" bpmnElement="Gateway_4">
        <dc:Bounds x="735" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="705" y="478" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="895" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="895" y="480" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <dc:Bounds x="1095" y="410" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_8_di" bpmnElement="End_8">
        <dc:Bounds x="1342" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1312" y="211" width="96" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="178" y="190" />
        <di:waypoint x="295" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="425" y="190" />
        <di:waypoint x="495" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="625" y="190" />
        <di:waypoint x="680" y="190" />
        <di:waypoint x="680" y="450" />
        <di:waypoint x="735" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="785" y="450" />
        <di:waypoint x="840" y="450" />
        <di:waypoint x="840" y="380" />
        <di:waypoint x="895" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="788" y="409" width="80" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="785" y="450" />
        <di:waypoint x="840" y="450" />
        <di:waypoint x="840" y="520" />
        <di:waypoint x="895" y="520" />
        <bpmndi:BPMNLabel><dc:Bounds x="788" y="479" width="80" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1025" y="380" />
        <di:waypoint x="1092" y="380" />
        <di:waypoint x="1092" y="410" />
        <di:waypoint x="1160" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1025" y="520" />
        <di:waypoint x="1092" y="520" />
        <di:waypoint x="1092" y="490" />
        <di:waypoint x="1160" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1225" y="450" />
        <di:waypoint x="1284" y="450" />
        <di:waypoint x="1284" y="190" />
        <di:waypoint x="1342" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>