<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P29" targetNamespace="http://bpmn.io/schema/bpmn" exporter="salon-de-belleza-familiar-docgen" exporterVersion="1.0">
  <bpmn:process id="P29" name="Elegir la forma de pago" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P29">
      <bpmn:lane id="Lane_1" name="Cliente">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Sistema">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Tiene la cita lista
para confirmar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_2" name="Elige la forma de pago:
efectivo o transferencia">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_3" name="¿Elige
transferencia?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_4" name="Sube el comprobante
(opcional en este paso)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="Marca el pago como
PENDIENTE DE VERIFICACIÓN">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Continúa a confirmar,
pago por verificar">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_7" name="Marca el pago como
EFECTIVO EN EL SALÓN">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="Continúa a
confirmar la cita">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_3" name="Sí" sourceRef="Gateway_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="End_6" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="Gateway_3" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_7" targetRef="End_8" />
    <bpmn:textAnnotation id="Annotation_9">
      <bpmn:text>Pendiente de implementar: hoy la base de
datos no guarda forma ni estado de pago.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Annotation_9_assoc" sourceRef="Task_2" targetRef="Annotation_9" associationDirection="None" />
  </bpmn:process>
