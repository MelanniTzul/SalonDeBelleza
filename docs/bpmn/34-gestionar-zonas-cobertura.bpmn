<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P34" targetNamespace="http://bpmn.io/schema/bpmn" exporter="salon-de-belleza-familiar-docgen" exporterVersion="1.0">
  <bpmn:process id="P34" name="Gestionar las zonas de cobertura a domicilio" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P34">
      <bpmn:lane id="Lane_1" name="Administrador">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Sistema">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Necesita ajustar
el servicio a domicilio">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_2" name="¿Qué
necesita hacer?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_3" name="Crea una zona con
su nombre y recargo">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4" name="Edita el nombre o
el recargo de una zona">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="Guarda los
cambios">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Zona
actualizada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_2" name="Crear" sourceRef="Gateway_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" name="Editar o desactivar" sourceRef="Gateway_2" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="End_6" />
    <bpmn:textAnnotation id="Annotation_7">
      <bpmn:text>Solo las zonas activas se ofrecen
al cliente al agendar a domicilio.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Annotation_7_assoc" sourceRef="Task_5" targetRef="Annotation_7" associationDirection="None" />
  </bpmn:process>
